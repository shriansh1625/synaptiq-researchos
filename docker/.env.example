# SynaptiQ ResearchOS — Docker environment variables
# Copy to docker/.env and adjust as needed:
#   cp docker/.env.example docker/.env

# --- API ---
API_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pre-computed demo (fill after a successful /analyze run for instant pitch demo)
NEXT_PUBLIC_DEMO_SESSION_ID=
NEXT_PUBLIC_DEMO_REPORT_ID=
NEXT_PUBLIC_DEMO_QUERY=How do retrieval-augmented generation systems reduce hallucination in scientific QA?
NEXT_PUBLIC_DEMO_LABEL=Hero demo
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=synaptiq
POSTGRES_PASSWORD=synaptiq
POSTGRES_DB=synaptiq
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# DATABASE_URL and REDIS_URL are composed inside docker-compose.yml
# using the internal service hostnames (postgres, redis).

# --- LLM provider ---
# Options: gemini | openrouter | deepseek
LLM_PROVIDER=gemini

# Gemini (when LLM_PROVIDER=gemini) — get key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_CONCURRENT=2
GEMINI_MIN_INTERVAL_SEC=0.4
DISCOVERY_MAX_PAPERS=8
DISCOVERY_MIN_PAPERS=4

# DeepSeek platform (when LLM_PROVIDER=deepseek) — key from platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=deepseek/deepseek-chat

SEMANTIC_SCHOLAR_API_KEY=

# --- Observability (Phase 4) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
BENCHMARK_FAST_ENABLED=true

# DATABASE_URL / REDIS_URL — composed inside docker-compose.yml for the API container.
# The localhost values below are only for host-side tooling; Docker overrides them.
DATABASE_URL=postgresql+asyncpg://synaptiq:synaptiq@localhost:5432/synaptiq
REDIS_URL=redis://localhost:6379/0

# --- Azure (optional in development) ---
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_APPS_ENVIRONMENT=
